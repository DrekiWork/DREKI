:: StoryCaption [Special] {"position":"100,250","size":"100,100"}
<<nobr>>

	/* Makes sure the player is in the game before attempting to present colony-relevant information. */
<<if hasVisited("tutorialOpen") || $cheat == true>>
	
	Cycle <<print $cycles>>, Day <<print $days>>
	<br>
		/* Links to ::bugTest, my cheat page, if cheating is enabled on game set. */
	<<if $cheat == true>>
		<<link "Cheating">><<goto "BugTest">><</link>>
	<</if>>
	
	<hr>
		/* Table contains stores. Left is amount collected, right is amount the colony can have. */
	<table>
		<tr>
			<td>Food: &ensp;</td>
				<td><<print $food>> </td> <td> &ensp; / &ensp; </td> <td> <<print $foodCap>> </td>
		</tr>
		<tr>
			<td>Water: &ensp;</td>
				<td> <<print $water>> </td> <td> / </td> <td> <<print $waterCap>> </td> <br>
		</tr>
		<tr>
			<td>Stone: &ensp;</td>
				<td> <<print $stone>> </td> <td> / </td> <td> <<print $buildingMaterialCap>> </td>
		</tr>
		<tr>
			<td>Wood: &ensp;</td> 
				<td> <<print $wood>> </td> <td> / </td> <td> <<print $buildingMaterialCap>> </td>
		</tr>
		<tr>
			<td>&emsp;</td>
		</tr>
		<tr>
			<td>Gold: &ensp;</td> <td><<print $gold>></td> <td></td>
		</tr>
	</table>

	<hr>
		/* Left side is amount of adult dragons currently occupying space, right side is how much shelter-space is available total. */
	<table>
		<tr>
			<td>Shelter Space: </td>
				<td>&ensp;</td> <td><<print $dragons.length>>&ensp;/&ensp;<<print $home>></td>
		</tr>
	</table>

	<hr>

	
	<details>
		<summary><h3>POLICIES ▼</h3></summary>
		<center>———</center>
		<details>
			<summary><h4>Social ▼</h4></summary>
			<<if $dragons.length > 0>>
						/* Lets dragons at end-day shelter themselves, instead of players manually assigning.
					   	   Autoselect is 'true'. */
					<label><<checkbox "$findSleep" false true autocheck>> Should dragons find their own places to sleep?</label><br>

						/* Lets dragons choose a job upon growing up, rather than the player manually assigning.
						   They choose based on personality and preferences, so unlucky players will still have to reassign.
						   Autoselect is 'false'. */
					<label><<checkbox "$jobHunt" false true autocheck>> Should dragons choose a job upon growing up?</label><br>
					<<run console.log("jobHunt is: " + $jobHunt)>>

						/* Runs <<tryForEgg>> at day-end, which starts the egg factory.
						   Production can get out of hand quick, so this is necessary.
						   Autoselect is 'true'. */
					<label><<checkbox "$freelyMate" false true autocheck>> Should dragons have eggs whenever they please? </label>
			<</if>><br>
		</details>

		<center>——</center>
	
		<<if $defenseTalk == true>><details>
		<summary><h4>Defense ▼</h4></summary>
				/* Lets rockfalls be loaded at day-end.
				   Autoselect is 'true' */
			<label><<checkbox "$autoLoad" false true autocheck>>Auto-load empty rockfalls?</label><br>
		</details>

		<center>——</center><</if>>
	</details>
<<else>>
	Welcome to DREKI: Thunder Simulator!
<</if>>
<</nobr>>


