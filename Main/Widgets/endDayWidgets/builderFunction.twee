:: BuilderRestDisplayWidget [widget]

	/* It is not part of endDay but IS part of the day-end logic, */
	/* specifically rest, so I will be putting it in the endDay */
	/* widget hole. */
<<widget "builderRestDisplay">><<nobr>>
	
	<<run console.log("buildQueue is: " + $buildQueue)>>
	<<countWorkers "builder">>
	
		/* First we're checking if we have builders and a queue. */
		/* If yes to both, your builders start working. */
		/* If you only have a queue and no builders, the game */
		/* Reminds the player to assign some builders to work. */
		/* If you have builders and no queue, the player is */
		/* Then told the builders are just chilling. */
	<<if $buildQueue.length > 0 && _wantedCount > 0>>

		<<setJobImage "builder">> Your <<plural _wantedCount "builder is" "builders are">>

		<<switch $builderStatus>>
			<<case 1>>
				working on plans for a <<print $buildQueue[0]>>.<br><br>

			<<case 2>>
				working on a <<print $buildQueue[0]>>;
				<<if _resourceDown == false>>
					they should be done in <<plural $buildTime "day" "days">>.
				<<else>>
					but have run out of material. They needed
					<<if _buildStone > 0>>
						<<print _buildStone>> stone;
					<</if>>
					<<if _buildWater > 0>>
						<<print _buildWater>> water;
					<</if>>
					<<if _buildWood > 0>>
						<<print _buildWood>> wood;
					<</if>>
					when they have what they need, the <<plural _wantedCount "builder" "builders">> will continue work.
				<</if>>
				<br><br>
			
			<<case 3>>
				just finishing up a <<print _finished>>!
				<<if $buildQueue.length > 0>>
					Tomorrow, they'll start planning for a <<print $buildQueue[0]>>.
				<<else>>
					They've got nothing else to build, so they'll be waiting for your next plans.
				<</if>>
				<br><br>

				<<default>>
					<<errorPopup "builderStatus">>

		<</switch>>
	
	<<elseif $buildQueue.length > 0 && _wantedCount == 0>>
		<<setJobImage "builder">> There's <<plural $buildQueue.length "building" "buildings">> to be built, but no one to build them.<br><br>
		

	<<elseif $buildQueue.length == 0 && _wantedCount > 0>>
		<<setJobImage "builder">> Your <<plural _wantedCount "builder is" "builders are">>

		<<if $builderStatus == 3>>
			just finishing up a <<print _finished>>! They've got nothing else to build, so they'll be waiting for your next plans.<br><br>
			<<set $builderStatus = 1>>
		<<else>>
			waiting for your next project.<br><br>
		<</if>>

	<<else>>

	<</if>>
<</nobr>><</widget>>

	/* Welcome to buildQueue. */
	/* buildQueue takes all the buildings */
	/* that players want their builders to build, */
	/* And sets them up for exactly that. */
<<widget "buildQueue">><<nobr>>

		/* First we check if buildQueue even NEEDS to do anything. */
		/* Then we look at if it CAN. */
		/* builderRestDisplay will handle telling the player, */
		/* but buildQueue needs to know so it doesn't fire erroneously. */
	<<if $buildQueue.length > 0>>

		<<countWorkers "builder">>

		<<if _wantedCount > 0>>

				/* With builders existent, resourceDown is set to note */
				/* It exists. Should it become true, it means we need */
				/* More of a resource. The other temporary variables */
				/* Then establish how much of a resource was needed */
				/* To complete the current stage of the structure. */
			<<set _resourceDown = false>>
			<<set _buildStart = false>>
			<<set _buildStone = 0>>
			<<set _buildWater = 0>>
			<<set _buildWood = 0>>

				/* Now we hop between different potential projects */
				/* Based on the first item in the buildQueue array. */
				/* These are organized in the following order: */
				/* Defenses, Job Sites, Shelters, Special, Storage. */
				/* Yes, it is out of order comparative to the build page. */
				/* No I do not care. */
				/* All buildings within these categories are organized */
				/* Alphabetically, like most things, for my sanity. */
			<<switch $buildQueue[0]>>

		/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ DEFENSES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
				<<case "moat">>
					<<run console.log("registered moat.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building moat.")>>
						<<if $defenseBuildings.moat.amount < 2>>
							<<set _buildStone = Math.round($defenseBuildings.moat.priceS / Math.clamp(Math.round($defenseBuildings.moat.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.moat.buildTime))>>
							<<set _buildWood = Math.round($defenseBuildings.moat.priceW / Math.clamp(Math.round($defenseBuildings.moat.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.moat.buildTime))>>
							<<if $stone >= _buildStone && $wood >= _buildWood>>
								<<set $buildTime -= 1>>
								<<set $stone -= _buildStone>>
								<<set $wood -= _buildWood>>
							<<else>>
								<<set _resourceDown = true>>
							<</if>>

						<<elseif $defenseBuildings.moat.amount == 2>>
							<<set _buildWater = Math.round($defenseBuildings.moat.priceWa / Math.clamp(Math.round($defenseBuildings.moat.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.moat.buildTime))>>
							<<if $water >= _buildWater>>
								<<set $buildTime -= 1>>
								<<set $water -= _buildWater>>
							<<else>>
								<<set _resourceDown = true>>
							<</if>>

						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($defenseBuildings.moat.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<if $buildTime < 1>>
							<<set $buildTime = 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus == 1>>
					
					<</if>>
					
				<<case "outpost">>
					<<run console.log("registered post.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building post.")>>
						<<set _buildStone = Math.round($defenseBuildings.outpost.priceS / Math.clamp(Math.round($defenseBuildings.outpost.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.outpost.buildTime))>>
							<<run console.log(_buildStone + " _buildStone")>>
						<<set _buildWood = Math.round($defenseBuildings.outpost.priceW / Math.clamp(Math.round($defenseBuildings.outpost.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.outpost.buildTime))>>
							<<run console.log(_buildWood + " _buildWood")>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<run console.log("buildTime is " + $buildTime)>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
							<<run console.log("_resourceDown = true, apparently." + _resourceDown)>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = (Math.round($defenseBuildings.outpost.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime = 1>>
						<</if>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<set _startBuild = true>>
						<<set $builderStatus to 1>>
					
					<</if>>

				<<case "palisade">>
					<<run console.log("registered pali.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building pali.")>>
						<<set _buildStone = Math.round($defenseBuildings.palisade.priceS / Math.clamp(Math.round($defenseBuildings.palisade.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.palisade.buildTime))>>
						<<set _buildWood = Math.round($defenseBuildings.palisade.priceW / Math.clamp(Math.round($defenseBuildings.palisade.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.palisade.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = (Math.round($defenseBuildings.palisade.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime > 1>>
							<<set $buildTime = 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus to 1>>

					<</if>>

				<<case "rockfall">>
					<<run console.log("registered rockfall.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building rockfall.")>>
						<<set _buildStone = Math.round($defenseBuildings.rockfall.priceS / Math.clamp(Math.round($defenseBuildings.rockfall.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.rockfall.buildTime))>>
						<<set _buildWood = Math.round($defenseBuildings.rockfall.priceW / Math.clamp(Math.round($defenseBuildings.rockfall.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $defenseBuildings.rockfall.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($defenseBuildings.rockfall.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<if $buildTime < 1>>
							<<set $buildTime = 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus to 1>>
					
					<</if>>


		/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ JOBSITES ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
				<<case "builderJobSite">>
				<<run console.log("Registered builder stockpile.")>>
				<<if $buildTime >= 1>>
						<<run console.log("started building jobsite - stockpile.")>>
						<<set _buildStone = Math.round($jobSites.builder.priceS / Math.clamp(Math.round($jobSites.builder.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.builder.buildTime))>>
						<<set _buildWood = Math.round($jobSites.builder.priceW / Math.clamp(Math.round($jobSites.builder.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.builder.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($jobSites.builder.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>
		
				<<case "foragerJobSite">>
				<<run console.log("Registered forager camp.")>>
				<<if $buildTime >= 1>>
						<<run console.log("started building jobsite - camp.")>>
						<<set _buildStone = Math.round($jobSites.forager.priceS / Math.clamp(Math.round($jobSites.forager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.forager.buildTime))>>
						<<set _buildWood = Math.round($jobSites.forager.priceW / Math.clamp(Math.round($jobSites.forager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.forager.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($jobSites.forager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>
		
				<<case "rainierJobSite">>
				<<run console.log("Registered rainier pond.")>>
				<<if $buildTime >= 1>>
						<<run console.log("started building jobsite - pond.")>>
						<<set _buildStone = Math.round($jobSites.rainier.priceS / Math.clamp(Math.round($jobSites.rainier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.rainier.buildTime))>>
						<<set _buildWood = Math.round($jobSites.rainier.priceW / Math.clamp(Math.round($jobSites.rainier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.rainier.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($jobSites.rainier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>
					
				<<case "salvagerJobSite">>
					<<run console.log("Registered salvager trove.")>>
					<<if $buildTime >= 1>>
							<<run console.log("started building jobsite - trove.")>>
							<<set _buildStone = Math.round($jobSites.salvager.priceS / Math.clamp(Math.round($jobSites.salvager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.salvager.buildTime))>>
							<<set _buildWood = Math.round($jobSites.salvager.priceW / Math.clamp(Math.round($jobSites.salvager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.salvager.buildTime))>>
							<<if $stone >= _buildStone && $wood >= _buildWood>>
								<<set $buildTime -= 1>>
								<<set $stone -= _buildStone>>
								<<set $wood -= _buildWood>>
							<<else>>
								<<set _resourceDown = true>>
							<</if>>

						<<else>>
							<<run console.log("Got ready.")>>
							<<set $buildTime = Math.round($jobSites.salvager.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
							<<run console.log("Buildtime 2: " + $buildTime)>>
							<<if $buildTime < 1>>
								<<set $buildTime += 1>>
							<</if>>
							<<set _startBuild = true>>
							<<set $builderStatus = 1>>
							
						<</if>>
		
				<<case "scavengerJobSite">>
					<<run console.log("Registered scavenger dropsite.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building jobsite - dropsite.")>>
						<<set _buildStone = Math.round($jobSites.scavenger.priceS / Math.clamp(Math.round($jobSites.scavenger.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.scavenger.buildTime))>>
						<<set _buildWood = Math.round($jobSites.scavenger.priceW / Math.clamp(Math.round($jobSites.scavenger.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.scavenger.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($jobSites.scavenger.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>
		
				<<case "soldierJobSite">>
					<<run console.log("Registered soldier cantonment.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building jobsite - cantonment.")>>
						<<set _buildStone = Math.round($jobSites.soldier.priceS / Math.clamp(Math.round($jobSites.soldier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.soldier.buildTime))>>
						<<set _buildWood = Math.round($jobSites.soldier.priceW / Math.clamp(Math.round($jobSites.soldier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $jobSites.soldier.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($jobSites.soldier.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>
				


		/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ SHELTERS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
				<<case "hollow">>
					<<run console.log("Registered hollow.")>>
					<<if $buildTime >= 1>>
						<<run console.log("started building hollow.")>>
						<<set _buildStone = Math.round($shelter.hollows.priceS / Math.clamp(Math.round($shelter.hollows.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1, $shelter.hollows.buildTime))>>
						<<set _buildWood = Math.round($shelter.hollows.priceW / Math.clamp(Math.round($shelter.hollows.buildTime * (2 / (Math.sqrt(_wantedCount) + 1))), 1,  $shelter.hollows.buildTime))>>
						<<if $stone >= _buildStone && $wood >= _buildWood>>
							<<set $buildTime -= 1>>
							<<set $stone -= _buildStone>>
							<<set $wood -= _buildWood>>
						<<else>>
							<<set _resourceDown = true>>
						<</if>>

					<<else>>
						<<run console.log("Got ready.")>>
						<<set $buildTime = Math.round($shelter.hollows.buildTime * (2 / (Math.sqrt(_wantedCount) + 1)))>>
						<<run console.log("Buildtime 2: " + $buildTime)>>
						<<if $buildTime < 1>>
							<<set $buildTime += 1>>
						<</if>>
						<<set _startBuild = true>>
						<<set $builderStatus = 1>>
						
					<</if>>

		/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ ERRORS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
				<<default>>
					<<errorPopup "buildQueueWeird">>

			<</switch>>
			
			<<if _buildStart !== true>>
				<<buildTimeCheck>>
			<</if>>

		<<else>>

		<</if>>

	<<else>>

	<</if>>

<</nobr>><</widget>>